{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://finpilot.local/schemas/ingestion-delivery/1.0-proposed.json",
  "title": "IngestionDeliveryEnvelope",
  "description": "Проект общей оболочки доставки. Не используется runtime приложением.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "delivery_key",
    "connection_id",
    "channel",
    "mode",
    "period_from",
    "period_to",
    "timezone",
    "generated_at",
    "parts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0-proposed"
    },
    "delivery_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "description": "Клиентский ключ идемпотентности transport."
    },
    "client_package_id": {
      "type": "string",
      "maxLength": 128,
      "description": "Внешний id пакета; конфликт содержимого обрабатывается сервером."
    },
    "connection_id": {
      "type": "string",
      "format": "uuid",
      "description": "SourceConnection; сервер сверяет с правами, не доверяет телу без auth."
    },
    "channel": {
      "type": "string",
      "enum": ["ui", "email", "api"]
    },
    "source_instance_id": {
      "type": "string",
      "maxLength": 128
    },
    "source_organization_id": {
      "type": "string",
      "maxLength": 128
    },
    "mode": {
      "type": "string",
      "enum": ["snapshot", "delta"]
    },
    "period_from": {
      "type": "string",
      "format": "date"
    },
    "period_to": {
      "type": "string",
      "format": "date"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "chunk_index": {
      "type": "integer",
      "minimum": 1
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 1
    },
    "completeness_claim": {
      "$ref": "#/$defs/completeness_claim"
    },
    "control_totals": {
      "$ref": "#/$defs/control_totals"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/delivery_part"
      }
    }
  },
  "$defs": {
    "completeness_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "through"],
      "properties": {
        "dataset": {
          "type": "string",
          "enum": ["cash", "revenue", "plan", "budget"]
        },
        "through": {
          "type": "string",
          "format": "date"
        },
        "scope": {
          "type": "string",
          "enum": ["explicit-dataset", "explicit-period"]
        }
      }
    },
    "control_totals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "cash_in": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "cash_out": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "revenue_net": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        }
      }
    },
    "delivery_part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_index", "dataset", "format", "content_sha256"],
      "properties": {
        "part_index": {
          "type": "integer",
          "minimum": 1
        },
        "dataset": {
          "type": "string",
          "enum": ["cash", "revenue", "plan", "budget"]
        },
        "format": {
          "type": "string",
          "enum": ["csv", "xlsx", "clientbank", "json_records"]
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "filename": {
          "type": "string",
          "maxLength": 255
        },
        "encoding": {
          "type": "string",
          "enum": ["utf-8", "utf-8-sig", "cp1251"]
        },
        "records": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/cash_record" },
              { "$ref": "#/$defs/revenue_record" },
              { "$ref": "#/$defs/plan_record" }
            ]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "format": { "const": "json_records" } },
            "required": ["format"]
          },
          "then": { "required": ["records"] }
        }
      ]
    },
    "cash_record": {
      "type": "object",
      "additionalProperties": false,
      "description": "Те же поля, что cash_transactions.csv; суммы строками с двумя знаками.",
      "required": [
        "external_id",
        "wallet_code",
        "business_date",
        "direction",
        "amount",
        "currency"
      ],
      "properties": {
        "external_id": { "type": "string", "maxLength": 128 },
        "wallet_code": { "type": "string", "maxLength": 64 },
        "business_date": { "type": "string", "format": "date" },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "currency": { "type": "string", "const": "RUB" },
        "counterparty_inn": { "type": "string", "maxLength": 12 },
        "counterparty_name": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 2000 },
        "document_number": { "type": "string", "maxLength": 64 },
        "category_code": { "type": "string", "maxLength": 64 },
        "direction_code": { "type": "string", "maxLength": 64 }
      }
    },
    "revenue_record": {
      "type": "object",
      "additionalProperties": false,
      "description": "Поля revenue.csv; отличие от CSV: JSON-типы, даты ISO.",
      "required": [
        "external_id",
        "recognition_date",
        "amount_ex_vat",
        "vat_amount",
        "amount_inc_vat",
        "entry_type"
      ],
      "properties": {
        "external_id": { "type": "string", "maxLength": 128 },
        "recognition_date": { "type": "string", "format": "date" },
        "document_number": { "type": "string", "maxLength": 64 },
        "counterparty_inn": { "type": "string", "maxLength": 12 },
        "amount_ex_vat": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "vat_amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "amount_inc_vat": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "entry_type": { "type": "string", "enum": ["sale", "return"] },
        "direction_code": { "type": "string", "maxLength": 64 }
      }
    },
    "plan_record": {
      "type": "object",
      "additionalProperties": false,
      "description": "Поля planned_cash.csv; connection.dataset=plan.",
      "required": [
        "external_id",
        "direction",
        "amount",
        "currency",
        "due_date",
        "confidence",
        "priority"
      ],
      "properties": {
        "external_id": { "type": "string", "maxLength": 128 },
        "direction": { "type": "string", "enum": ["in", "out"] },
        "amount": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
        "currency": { "type": "string", "const": "RUB" },
        "due_date": { "type": "string", "format": "date" },
        "expected_date": { "type": "string", "format": "date" },
        "category_code": { "type": "string", "maxLength": 64 },
        "counterparty_inn": { "type": "string", "maxLength": 12 },
        "confidence": {
          "type": "string",
          "enum": ["confirmed", "expected", "tentative"]
        },
        "priority": {
          "type": "string",
          "enum": ["critical", "high", "normal", "low"]
        },
        "wallet_code": { "type": "string", "maxLength": 64 }
      }
    }
  }
}
