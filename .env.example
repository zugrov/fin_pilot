WORKER_DATABASE_URL=postgresql+psycopg://finpilot_worker:change-me@postgres:5432/finpilot
MIGRATION_DATABASE_URL=postgresql+psycopg://finpilot:change-me@postgres:5432/finpilot
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_BACKEND=redis
SESSION_SECRET=change-me
