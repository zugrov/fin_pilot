SESSION_COOKIE_SECURE=false
SEND_EXTERNAL_MESSAGES=false
SEND_REAL_EMAIL=false
SEND_LIVE_PAYMENTS=false
BILLING_MODE=test
BILLING_GRACE_DAYS=3
ANNUAL_BILLING_ENABLED=true
ANNUAL_DISCOUNT_PERCENT=15.00
EMAIL_PROVIDER_MODE=mock
REFUNDS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:5173/billing/return
YOOKASSA_IP_ALLOWLIST=
TRUST_PROXY=false
RECEIPT_MODE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
BILLING_STAFF_EMAILS=
BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
IMPORT_STORAGE_DIR=var/imports
IMPORT_MAX_BYTES=20971520
IMPORT_MAX_ROWS=100000
IMPORT_MAX_UNCOMPRESSED_BYTES=52428800
POSTGRES_PASSWORD=change-me
